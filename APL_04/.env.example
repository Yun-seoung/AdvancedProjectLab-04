# 이 파일을 복사해 .env로 만들고 값을 채운다:  copy .env.example .env
# .env는 APL_04/.env 또는 저장소 루트 .env 어디에 둬도 서버 시작 때 자동으로 읽힌다(APL_04가 우선).
# 터미널에서 먼저 지정한 환경변수($env:KEY=...)는 .env보다 우선한다. 값이 없는 항목은 주석 처리해 둔다.
# 아무것도 설정하지 않으면 전사·요약·결정 컴파일은 가짜(고정) 응답으로 동작한다.

# ===== Django =====
# 1이면 개발 모드. 0(운영)이면 DJANGO_SECRET_KEY가 반드시 필요하다.
DJANGO_DEBUG=1
# 운영(DJANGO_DEBUG=0)에서 필수. 개발에서는 비워 두면 임시 키를 쓴다.
# DJANGO_SECRET_KEY=
# 쉼표로 구분. 기본: localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cloudflare Tunnel 등 https 프록시 뒤에서 쓸 때 쉼표로 구분 (예: https://example.trycloudflare.com)
# DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== LLM: 요약 · 결정 컴파일 · 챗봇 =====
# 하나만 설정해도 LLM이 켜진다. 순서는 Gemini → (실패 시) Groq → (실패 시) Ollama.
# Gemini: 키와 모델 ID가 둘 다 있어야 한다. https://aistudio.google.com 에서 무료 발급
# GEMINI_API_KEY=
# GEMINI_MODEL=
# 응답 대기 초. 기본 300
# GEMINI_TIMEOUT=300

# Groq: 키와 모델 ID가 둘 다 있어야 한다. STT에 쓰는 GROQ_API_KEY와 같은 키를 쓰면 된다
# (https://console.groq.com 에서 무료 발급). 모델 ID는 콘솔의 현재 무료 모델 목록에서 확인한다.
# GROQ_LLM_MODEL=

# Ollama(로컬): 모델 이름을 적으면 켜진다. 먼저 `ollama pull <모델>` 필요
# OLLAMA_MODEL=qwen2.5:7b
# 기본: http://127.0.0.1:11434/api/generate
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
# 컨텍스트 길이. 기본 16384 (긴 회의면 늘리고, 메모리가 부족하면 줄인다)
# OLLAMA_NUM_CTX=16384

# ===== STT(전사): CLOVA → Groq → 로컬 Whisper 순서로 시도, 앞 단계가 없거나 실패하면 다음으로 =====
# CLOVA Speech: URL과 키가 둘 다 있어야 켜진다 (네이버 클라우드 콘솔 > 빌더 > 설정 > 연동 정보)
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET_KEY=
# 월 무료 사용량(분). 기본 20
# CLOVA_SPEECH_FREE_MINUTES=20
# 1이면 화자 분리 사용
# CLOVA_SPEECH_DIARIZATION=0

# Groq Whisper API: https://console.groq.com 에서 무료 발급
# GROQ_API_KEY=
# 기본: whisper-large-v3-turbo
# GROQ_MODEL=whisper-large-v3-turbo

# 로컬 Whisper: 로컬 전사를 CLOVA보다 우선시키려면 CLOVA·Groq 항목을 주석 처리한다.
# Windows·Linux 등 모든 OS: faster-whisper (pip install faster-whisper 필요)
# FASTER_WHISPER_MODEL=large-v3-turbo
# GPU가 없거나 CUDA 설정이 안 되면 cpu / int8 로 지정
# FASTER_WHISPER_DEVICE=auto
# FASTER_WHISPER_COMPUTE_TYPE=default
# Apple Silicon Mac 전용: mlx-whisper. 둘 다 있으면 MLX가 우선
# MLX_WHISPER_MODEL=
