# 이 파일을 .env 로 복사해서 쓴다. .env 는 절대 커밋하지 않는다.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# DB: 비워두면 SQLite(db.sqlite3)를 쓴다.
DATABASE_URL=

# STT / LLM 공급자: mock | gemini
STT_PROVIDER=mock
LLM_PROVIDER=mock

# Gemini (Phase 2에서 사용). 키는 비워둔 채로 공유한다.
GEMINI_API_KEY=
GEMINI_STT_MODEL=
GEMINI_LLM_MODEL=
